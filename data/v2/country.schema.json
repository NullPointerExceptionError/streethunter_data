{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StreetHunter administrative country manifest",
  "type": "object",
  "required": ["country", "schema_version", "catalog_version", "boundaries", "endpoints", "identities", "lineage"],
  "properties": {
    "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "schema_version": { "const": 1 },
    "catalog_version": { "$ref": "#/$defs/positive_integer" },
    "boundaries": { "$ref": "#/$defs/file" },
    "endpoints": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/area_id" },
      "additionalProperties": {
        "type": "object",
        "required": ["id", "reference_count", "street_count", "file"],
        "properties": {
          "id": { "$ref": "#/$defs/area_id" },
          "reference_count": { "$ref": "#/$defs/positive_integer" },
          "street_count": { "$ref": "#/$defs/positive_integer" },
          "file": { "$ref": "#/$defs/file" }
        }
      }
    },
    "identities": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/area_id" },
      "additionalProperties": {
        "type": "object",
        "required": ["active", "geometry_sha256", "geometry_version", "osm_sources"],
        "properties": {
          "active": { "type": "boolean" },
          "geometry_sha256": { "$ref": "#/$defs/sha256" },
          "geometry_version": { "$ref": "#/$defs/positive_integer" },
          "osm_sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^(relation|way):[0-9]+$" }
          }
        }
      }
    },
    "lineage": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "prefixItems": [
          { "$ref": "#/$defs/positive_integer" },
          { "$ref": "#/$defs/area_id" },
          { "$ref": "#/$defs/area_id" }
        ]
      }
    }
  },
  "$defs": {
    "positive_integer": { "type": "integer", "minimum": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "area_id": { "type": "string", "pattern": "^[A-Z]{2}-[0-9a-f]{32}$" },
    "asset": {
      "type": "object",
      "required": ["url", "size_bytes", "sha256"],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/NullPointerExceptionError/streethunter_data/releases/download/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "file": {
      "type": "object",
      "required": ["version", "size_bytes", "sha256", "assets"],
      "properties": {
        "version": { "$ref": "#/$defs/positive_integer" },
        "size_bytes": { "$ref": "#/$defs/positive_integer" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "assets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/asset" } }
      }
    }
  }
}
